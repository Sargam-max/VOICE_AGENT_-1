# LiveKit Cloud or Self-Hosted URL and API Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Speech-to-Text (AssemblyAI)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Text-to-Speech (Cartesia)
CARTESIA_API_KEY=your_cartesia_api_key

# Large Language Model (Google Gemini)
GOOGLE_API_KEY=your_gemini_api_key

# Agent Dispatch & Server Configuration
LIVEKIT_AGENT_NAME=my-voice-agent
PORT=8000
HOST=0.0.0.0

# ==============================================================================
# Per-User Google OAuth 2.0 & Official Gmail API v1 (Recommended)
# ==============================================================================
# Setup in Google Cloud Console (https://console.cloud.google.com):
# 1. Enable "Gmail API" and "Google Calendar API" in APIs & Services.
# 2. Configure OAuth Consent Screen (User Type: External, add scopes:
#    https://www.googleapis.com/auth/gmail.send,
#    https://www.googleapis.com/auth/gmail.readonly,
#    https://www.googleapis.com/auth/userinfo.email)
# 3. Create OAuth 2.0 Client ID (Web Application):
#    - Authorized redirect URIs:
#      * http://localhost:8000/auth/google/callback (for local testing)
#      * https://voiceagent-1-production.up.railway.app/auth/google/callback (for production)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: explicitly override redirect URI (if omitted, auto-detected via Host & X-Forwarded-Proto headers)
# GOOGLE_REDIRECT_URI=https://voiceagent-1-production.up.railway.app/auth/google/callback

# ==============================================================================
# MCP (Model Context Protocol) Tools Configuration (All 100% Free)
# ==============================================================================
# 1. Web Search & News (DuckDuckGo): 100% FREE, no API keys or configuration needed!

# 2. Calendar: Built-in persistent scheduling works immediately out-of-the-box!
# Optional: To sync your real Google Calendar, paste your free Google Calendar secret iCal URL
# (Google Calendar Settings -> Integrate Calendar -> "Secret address in iCal format")
GOOGLE_CALENDAR_ICAL_URL=

# 3. Legacy Gmail Fallback (Optional):
# If Google OAuth 2.0 is not configured above, you can optionally set a static App Password
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
